# Mac OS
.DS_Store

# NPM
/node_modules
npm-*

# Testing
/.nyc_output
/coverage

# Build
/build
/dist
/.opt-in

# Generated translation files
/translations
/locale

# Other generated source
/src/generated

# Local environment files
.env
.env.local
.env.example
.env.*.local

# Downloaded during "npm install"
/static/microbit

# for act
.secrets

# Claude Code local settings (per-developer, not shared)
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Supabase CLI local cache (project ref, pooler host, tool versions)
/supabase/.temp

# Notas internas de desarrollo/auditoría (no van al repo público)
/md resumen

# Assets de referencia del template original de scratch-gui, sin uso en src/
/docs

# Workflows heredados de Scratch/MIT, no aplican a este fork
/.github/workflows/daily-tx-pull.yml
/.github/workflows/signature-assistant.yml

# Esquema de base de datos y políticas RLS: no exponer la estructura de la BD
/supabase/migrations
/supabase/tests

# SVG de trabajo para la librería de objetos (ya subidos al bucket)
/src/assets/svg-temporales-libreria-objetos/

# Archivos renombrados por hash, listos para subir al bucket (los genera scripts/preparar-assets.mjs)
/assets-por-subir/

# Fondos y sonidos propios de la librería: se suben al bucket (scripts/preparar-assets.mjs).
# Los fondo-*.svg son decoración de la landing y sí van en git.
/src/assets/fondos/*
!/src/assets/fondos/fondo-*.svg
/src/assets/audios/

# Herramienta local para preparar assets
/scripts/preparar-assets.mjs
